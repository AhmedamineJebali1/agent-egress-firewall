# Optional. Copy to .env to override defaults; the lab runs without this file.

# The canary the agent holds and the firewall protects. Any string works; the
# detector is told what to look for, it does not guess.
AGENT_SECRET=CANARY-sk-7f3a9c2e8b4d6a1f-LEAKTEST

# Drive a real model instead of the deterministic stand-in, for the demo.
# The provider host must also be added to config/policy.json, because the
# firewall does not special-case anyone.
#
#   LLM_PROVIDER=openai          # or anthropic
#   LLM_API_KEY=sk-...
#   LLM_MODEL=gpt-4o-mini        # or claude-sonnet-4-5
#   LLM_BASE_URL=                # set for an OpenAI-compatible endpoint
